@model IReadOnlyList<PremierProformas.ViewModels.UsuarioListItemViewModel>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuarios</h1>
    <a class="btn btn-primary" asp-action="Crear">Crear usuario</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Correo</th>
                <th>Rol</th>
                <th>Vendedor</th>
                <th>Sucursal</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Email</td>
                <td>@usuario.Roles</td>
                <td>@(usuario.Vendedor ?? "-")</td>
                <td>@(usuario.Sucursal ?? "-")</td>
                <td>@(usuario.Activo ? "Activo" : "Desactivado")</td>
                <td>
                    <div class="d-flex flex-wrap gap-2">
                        <form asp-action="CambiarEstado" method="post">
                            <input type="hidden" name="id" value="@usuario.Id" />
                            <input type="hidden" name="activar" value="@(!usuario.Activo)" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">
                                @(usuario.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                        <form asp-action="RestablecerContrasena" method="post" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@usuario.Id" />
                            <input class="form-control form-control-sm" type="password" name="nuevaContrasena"
                                   minlength="8" autocomplete="new-password" placeholder="Nueva contraseña" required />
                            <button class="btn btn-sm btn-outline-primary" type="submit">Restablecer</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>