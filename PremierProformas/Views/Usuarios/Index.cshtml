@model IReadOnlyList<PremierProformas.ViewModels.UsuarioListItemViewModel>
@{
    ViewData["Title"] = "Usuarios";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">SEGURIDAD <span>/</span> ACCESOS</p>
        <h1>Usuarios</h1>
        <p class="page-subtitle">Administra cuentas, roles y asignaciones de equipo.</p>
    </div>
    <a class="btn btn-primary create-user-button" asp-action="Crear"><span aria-hidden="true">+</span> Crear usuario</a>
</section>

<div class="user-summary" aria-label="Resumen de usuarios">
    <div class="summary-cell"><span class="summary-label">CUENTAS</span><strong>@Model.Count</strong></div>
    <div class="summary-cell"><span class="summary-label">ACTIVAS</span><strong>@Model.Count(usuario => usuario.Activo)</strong></div>
    <div class="summary-cell"><span class="summary-label">DESACTIVADAS</span><strong>@Model.Count(usuario => !usuario.Activo)</strong></div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="users-table-wrap">
    <table class="table users-table align-middle">
        <thead>
            <tr>
                <th scope="col">Usuario</th>
                <th scope="col">Rol</th>
                <th scope="col">Vendedor</th>
                <th scope="col">Sucursal</th>
                <th scope="col">Estado</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td><span class="user-email">@usuario.Email</span></td>
                <td><span class="role-label">@usuario.Roles</span></td>
                <td>@(usuario.Vendedor ?? "-")</td>
                <td>@(usuario.Sucursal ?? "-")</td>
                <td><span class="status-label @(usuario.Activo ? "is-active" : "is-disabled")"><span></span>@(usuario.Activo ? "Activo" : "Desactivado")</span></td>
                <td class="user-actions-cell">
                    <div class="user-actions">
                        <form asp-action="CambiarEstado" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@usuario.Id" />
                            <input type="hidden" name="activar" value="@(!usuario.Activo)" />
                            <button class="btn btn-sm btn-outline-secondary state-button" type="submit">
                                @(usuario.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                        <details class="reset-details">
                            <summary class="btn btn-sm btn-outline-primary">Cambiar contraseña</summary>
                            <form asp-action="RestablecerContrasena" method="post" class="reset-form">
                                <label class="form-label" for="password-@usuario.Id">Nueva contraseña</label>
                                <input id="password-@usuario.Id" class="form-control form-control-sm" type="password" name="nuevaContrasena"
                                       minlength="8" autocomplete="new-password" placeholder="Mínimo 8 caracteres" required />
                                <input type="hidden" name="id" value="@usuario.Id" />
                                <button class="btn btn-primary btn-sm" type="submit">Guardar contraseña</button>
                            </form>
                        </details>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>